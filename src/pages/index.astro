---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, telLink } from '../data/site';
import { pagina } from '../lib/paginas';
import { linha } from '../lib/texto';

const p = await pagina('inicio');

const noticias = (await getCollection('noticias', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);

const formatarData = (d: Date) =>
  d.toLocaleDateString('pt-PT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base description={p.descricao || undefined}>
  <section class="heroi">
    <div class="contentor heroi__interior">
      <div>
        {p.heroi_pre && <p class="heroi__pre">{p.heroi_pre}</p>}
        <h1 set:html={linha(p.heroi_titulo)} />
        <p class="heroi__texto" set:html={linha(p.heroi_texto)} />
        <div class="heroi__acoes">
          <a class="botao botao-claro" href="/apoiar/">{p.heroi_botao1 || 'Ser sócio ou doar'}</a>
          <a class="botao botao-contorno" href="/ser-bombeiro/">{p.heroi_botao2 || 'Quero ser bombeiro'}</a>
        </div>
      </div>
      <a class="cartao-112" href={telLink(site.emergencia)}>
        <span>Em caso de emergência</span>
        <strong>{site.emergencia}</strong>
        <span>Chamada gratuita, 24 horas</span>
      </a>
    </div>
  </section>

  <section class="seccao">
    <div class="contentor">
      <h2 class="sem-margem">{p.ajudar_titulo}</h2>
      <div class="grelha">
        {
          (p.ajudar ?? []).map((c: any) => (
            <a class="cartao cartao-acao" href={c.ligacao}>
              <h3>{c.titulo}</h3>
              <p set:html={linha(c.texto)} />
              {c.chamada && <span aria-hidden="true">{c.chamada} →</span>}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seccao seccao-alt">
    <div class="contentor">
      <h2 class="sem-margem">{p.fazemos_titulo}</h2>
      <div class="grelha">
        {
          (p.fazemos ?? []).map((c: any) => (
            <div class="cartao">
              <h3>{c.titulo}</h3>
              <p set:html={linha(c.texto)} />
            </div>
          ))
        }
      </div>
      <p><a href="/servicos/">Ver todos os serviços →</a></p>
    </div>
  </section>

  <section class="seccao">
    <div class="contentor">
      <div class="grelha-2">
        <div>
          <h2 class="sem-margem">{p.noticias_titulo}</h2>
          <ul class="lista-noticias">
            {
              noticias.map((n) => (
                <li>
                  <time datetime={n.data.data.toISOString().slice(0, 10)}>{formatarData(n.data.data)}</time>
                  <a href={`/noticias/${n.id}/`}>{n.data.titulo}</a>
                </li>
              ))
            }
          </ul>
          <p><a href="/noticias/">Todas as notícias →</a></p>
        </div>
        <div class="cartao risco">
          <h2 class="sem-margem">{p.risco_titulo}</h2>
          <p set:html={linha(p.risco_texto)} />
          <p>
            <a class="botao botao-secundario" href="https://www.ipma.pt/pt/riscoincendio/rcm.pt/" rel="noopener">
              Ver risco no IPMA
            </a>
          </p>
          <p><a href="/prevencao/">Conselhos de prevenção →</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .heroi {
    background:
      linear-gradient(120deg, rgb(138 13 20 / 96%), rgb(179 18 27 / 88%)),
      var(--vermelho);
    color: #fff;
    padding: 3.5rem 0;
  }

  .heroi__interior {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 52rem) {
    .heroi__interior {
      grid-template-columns: 1fr 18rem;
    }
  }

  .heroi__pre {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.85;
    margin: 0 0 0.75rem;
  }

  .heroi__texto {
    font-size: 1.15rem;
    max-width: 38rem;
    opacity: 0.95;
  }

  .heroi__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .botao-contorno {
    color: #fff;
    border-color: #fff;
  }

  .botao-contorno:hover {
    background: #fff;
    color: var(--vermelho);
  }

  .cartao-112 {
    display: grid;
    justify-items: center;
    text-align: center;
    background: #fff;
    color: var(--vermelho);
    border-radius: 16px;
    padding: 1.5rem;
    text-decoration: none;
    box-shadow: 0 10px 30px rgb(0 0 0 / 25%);
  }

  .cartao-112 strong {
    font-size: 4.5rem;
    line-height: 1;
    margin: 0.25rem 0;
  }

  .cartao-112 span {
    color: var(--tinta);
    font-weight: 600;
  }

  .sem-margem {
    margin-top: 0;
  }

  .seccao-alt {
    background: var(--fundo-alt);
  }

  .seccao-alt .cartao {
    background: #fff;
  }

  .cartao-acao {
    text-decoration: none;
    color: var(--tinta);
    transition: box-shadow 0.15s, border-color 0.15s;
  }

  .cartao-acao:hover {
    border-color: var(--vermelho);
    box-shadow: var(--sombra);
    color: var(--tinta);
  }

  .cartao-acao span {
    color: var(--vermelho);
    font-weight: 600;
  }

  .grelha-2 {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 52rem) {
    .grelha-2 {
      grid-template-columns: 3fr 2fr;
    }
  }

  .lista-noticias {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .lista-noticias li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--linha);
    display: grid;
  }

  .lista-noticias time {
    font-size: 0.9rem;
    color: var(--tinta-suave);
  }

  .lista-noticias a {
    font-weight: 600;
    font-size: 1.1rem;
  }

  .risco {
    border-top: 4px solid var(--amarelo);
  }
</style>

---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Texto from '../components/Texto.astro';
import { pagina } from '../lib/paginas';
import { linha } from '../lib/texto';

const p = await pagina('prevencao');
---

<Base title={p.titulo} description={p.descricao || undefined}>
  <CabecalhoPagina titulo={p.titulo} resumo={p.resumo} />

  <div class="contentor seccao">
    <div class="grelha">
      {
        (p.ligacoes ?? []).map((l: any) => (
          <a class="cartao ligacao" href={l.url} rel="noopener">
            <h3>{l.titulo}</h3>
            <p set:html={linha(l.texto)} />
          </a>
        ))
      }
    </div>

    <div class="prosa">
      <Texto md={p.corpo} />
    </div>
  </div>
</Base>

<style>
  .ligacao {
    text-decoration: none;
    color: var(--tinta);
    border-top: 4px solid var(--amarelo);
  }

  .ligacao:hover {
    box-shadow: var(--sombra);
    color: var(--tinta);
  }

  .ligacao h3 {
    color: var(--vermelho);
    margin-top: 0;
  }
</style>

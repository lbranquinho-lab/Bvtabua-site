---
// Ocorrências ativas no concelho de Tábua (dados da ANEPC via Fogos.pt), lidas de /api/ocorrencias.php.
// A caixa fica escondida enquanto não houver chave de acesso no servidor ou se o pedido falhar.
---

<section class="ocorrencias" hidden aria-live="polite">
  <div class="contentor">
    <div class="ocorrencias__topo">
      <h2>Ocorrências em Tábua agora</h2>
      <p class="ocorrencias__hora"></p>
    </div>
    <ul class="ocorrencias__lista"></ul>
    <p class="ocorrencias__vazio" hidden>Não há ocorrências ativas no concelho de Tábua neste momento.</p>
    <p class="ocorrencias__fonte">
      Fonte: <a href="https://fogos.pt" rel="noopener">Fogos.pt</a>, com dados da ANEPC. Informação indicativa e com
      localização aproximada. Em caso de emergência ligue 112.
    </p>
  </div>
</section>

<style>
  .ocorrencias {
    background: #fff8e6;
    border-bottom: 1px solid #f0d88a;
    padding: 1.5rem 0;
  }

  .ocorrencias__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .ocorrencias h2 {
    margin: 0;
    font-size: 1.3rem;
  }

  .ocorrencias__hora,
  .ocorrencias__fonte {
    margin: 0;
    font-size: 0.9rem;
    color: var(--tinta-suave);
  }

  .ocorrencias__lista {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }

  .ocorrencias__lista :global(li) {
    background: #fff;
    border: 1px solid var(--linha);
    border-left: 5px solid var(--cor, var(--vermelho));
    border-radius: var(--raio);
    padding: 0.75rem 1rem;
  }

  .ocorrencias__lista :global(strong) {
    display: block;
  }

  .ocorrencias__lista :global(.estado) {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .ocorrencias__lista :global(.meios),
  .ocorrencias__lista :global(.onde) {
    font-size: 0.9rem;
    color: var(--tinta-suave);
    margin: 0.2rem 0 0;
  }

  .ocorrencias__vazio {
    margin: 0.75rem 0;
  }
</style>

<script>
  type Ocorrencia = {
    natureza: string;
    estado: string;
    cor: string;
    freguesia: string;
    localidade: string;
    hora: string;
    data: string;
    operacionais: number;
    terrestres: number;
    aereos: number;
  };

  const seccao = document.querySelector<HTMLElement>('.ocorrencias');

  function texto(etiqueta: string, conteudo: string, classe?: string) {
    const el = document.createElement(etiqueta);
    el.textContent = conteudo;
    if (classe) el.className = classe;
    return el;
  }

  function mostrar(lista: Ocorrencia[]) {
    if (!seccao) return;
    const ul = seccao.querySelector('.ocorrencias__lista')!;
    const vazio = seccao.querySelector<HTMLElement>('.ocorrencias__vazio')!;
    ul.replaceChildren(
      ...lista.map((o) => {
        const li = document.createElement('li');
        if (o.cor) li.style.setProperty('--cor', `#${o.cor}`);
        li.append(texto('strong', o.natureza || 'Ocorrência'));
        li.append(texto('span', o.estado, 'estado'));
        const onde = [o.localidade, o.freguesia].filter(Boolean).join(', ');
        const quando = o.hora ? `desde as ${o.hora}` : '';
        if (onde || quando) li.append(texto('p', [onde, quando].filter(Boolean).join(' · '), 'onde'));
        const meios = [
          o.operacionais ? `${o.operacionais} ${o.operacionais === 1 ? 'operacional' : 'operacionais'}` : '',
          o.terrestres ? `${o.terrestres} ${o.terrestres === 1 ? 'meio terrestre' : 'meios terrestres'}` : '',
          o.aereos ? `${o.aereos} ${o.aereos === 1 ? 'meio aéreo' : 'meios aéreos'}` : '',
        ].filter(Boolean);
        if (meios.length) li.append(texto('p', meios.join(' · '), 'meios'));
        return li;
      }),
    );
    vazio.hidden = lista.length > 0;
    seccao.querySelector('.ocorrencias__hora')!.textContent = `Atualizado às ${new Date().toLocaleTimeString('pt-PT', {
      hour: '2-digit',
      minute: '2-digit',
    })}`;
    seccao.hidden = false;
  }

  async function atualizar() {
    try {
      const r = await fetch('/api/ocorrencias.php', { cache: 'no-store' });
      if (!r.ok) return;
      const dados = await r.json();
      if (dados?.ativo && Array.isArray(dados.ocorrencias)) mostrar(dados.ocorrencias);
    } catch {
      // Sem PHP, sem chave ou sem rede: a caixa continua escondida.
    }
  }

  if (seccao) {
    atualizar();
    setInterval(atualizar, 120_000);
  }
</script>

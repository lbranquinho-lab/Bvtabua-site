---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Texto from '../components/Texto.astro';
import { pagina } from '../lib/paginas';
import Formulario from '../components/Formulario.astro';
import { site, telLink } from '../data/site';

const p = await pagina('contactos');
const assuntos: string[] = p.assuntos?.length ? p.assuntos : ['Informação geral', 'Outro'];
---

<Base title={p.titulo} description={p.descricao || undefined}>
  <CabecalhoPagina titulo={p.titulo} resumo={p.resumo} />

  <div class="contentor seccao">
    <div class="colunas">
      <div>
        <dl class="dados">
          <dt>Emergência</dt>
          <dd><a href={telLink(site.emergencia)}><strong>{site.emergencia}</strong></a></dd>
          <dt>Quartel (24 horas)</dt>
          <dd><a href={telLink(site.telefone)}>{site.telefone}</a></dd>
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          <dt>Morada</dt>
          <dd>{site.morada}<br /><a href={site.mapaUrl} rel="noopener">Ver no mapa</a></dd>
          <dt>Secretaria</dt>
          <dd>{site.horarioSecretaria}</dd>
        </dl>
      </div>
      <div>
        <h2 class="sem-margem">{p.formulario_titulo || 'Envie-nos uma mensagem'}</h2>
        <Formulario assunto="Contacto pelo site">
          <label>Nome <input name="nome" autocomplete="name" required /></label>
          <label>Email <input name="email" type="email" autocomplete="email" required /></label>
          <label>
            Assunto
            <select name="assunto">
              {assuntos.map((a) => <option>{a}</option>)}
            </select>
          </label>
          <label>Mensagem <textarea name="mensagem" rows="5" required></textarea></label>
        </Formulario>
      </div>
    </div>

    <div class="prosa" id="denuncias">
      <Texto md={p.corpo} />
    </div>
  </div>
</Base>

<style>
  .colunas {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 52rem) {
    .colunas {
      grid-template-columns: 1fr 1.3fr;
    }
  }

  .sem-margem {
    margin-top: 0;
  }

  .dados {
    margin: 0;
  }

  .dados dt {
    font-size: 0.9rem;
    color: var(--tinta-suave);
    margin-top: 1.1rem;
  }

  .dados dt:first-child {
    margin-top: 0;
  }

  .dados dd {
    margin: 0.15rem 0 0;
    font-size: 1.1rem;
  }
</style>

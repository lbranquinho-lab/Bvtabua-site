---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Texto from '../components/Texto.astro';
import { pagina } from '../lib/paginas';
import Formulario from '../components/Formulario.astro';
import { html } from '../lib/texto';

const p = await pagina('ser-bombeiro');
---

<Base title="Ser bombeiro" description={p.descricao || undefined}>
  <CabecalhoPagina titulo={p.titulo} resumo={p.resumo} />

  <div class="contentor seccao prosa">
    <div class="primeiro"><Texto md={p.corpo} /></div>

    <h2 id="perguntas">{p.perguntas_titulo || 'Perguntas frequentes'}</h2>
    {
      (p.perguntas ?? []).map((q: any) => (
        <details class="pergunta">
          <summary>{q.pergunta}</summary>
          <Fragment set:html={html(q.resposta)} />
        </details>
      ))
    }

    <h2 id="candidatura">{p.candidatura_titulo || 'Candidatura'}</h2>
    <Formulario assunto="Candidatura a bombeiro voluntário" botao="Enviar candidatura">
      <label>Nome completo <input name="nome" autocomplete="name" required /></label>
      <label>Data de nascimento <input name="nascimento" type="date" required /></label>
      <label>Telemóvel <input name="telefone" type="tel" autocomplete="tel" required /></label>
      <label>Email <input name="email" type="email" autocomplete="email" /></label>
      <label>Localidade <input name="localidade" required /></label>
      <label>Porque quer ser bombeiro? <textarea name="motivacao" rows="4"></textarea></label>
    </Formulario>
  </div>
</Base>

<style>
  .primeiro :global(h2:first-child) {
    margin-top: 0;
  }

  .pergunta {
    border-bottom: 1px solid var(--linha);
    padding: 0.75rem 0;
  }

  .pergunta summary {
    font-weight: 600;
    cursor: pointer;
  }

  .pergunta :global(p) {
    margin: 0.5rem 0 0;
  }
</style>

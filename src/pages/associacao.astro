---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Texto from '../components/Texto.astro';
import { pagina } from '../lib/paginas';
import { linha } from '../lib/texto';

const p = await pagina('associacao');
const documentos: { ano?: number | string; titulo: string; ficheiro: string }[] = p.documentos ?? [];
---

<Base title={p.titulo} description={p.descricao || undefined}>
  <CabecalhoPagina titulo={p.titulo} resumo={p.resumo} />

  <div class="contentor seccao prosa">
    <Texto md={p.corpo} />

    <h2 id="orgaos-sociais">{p.orgaos_titulo || 'Órgãos sociais'}</h2>
    <Texto md={p.orgaos_texto} />
    <div class="grelha">
      {
        (p.orgaos ?? []).map((o: any) => (
          <div class="cartao">
            <h3>{o.nome}</h3>
            <p set:html={linha(o.membros)} />
          </div>
        ))
      }
    </div>

    <div id="memoria"><Texto md={p.memoria} /></div>

    <h2 id="transparencia">Transparência</h2>
    <Texto md={p.transparencia_texto} />
    {
      documentos.length > 0 ? (
        <table>
          <thead>
            <tr>
              <th>Ano</th>
              <th>Documento</th>
            </tr>
          </thead>
          <tbody>
            {documentos.map((d) => (
              <tr>
                <td>{d.ano}</td>
                <td>
                  <a href={d.ficheiro}>{d.titulo}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="provisorio"><strong>Texto provisório.</strong> Enviar em PDF: estatutos, relatório e contas e plano de atividades e orçamento dos últimos anos.</p>
      )
    }
  </div>
</Base>

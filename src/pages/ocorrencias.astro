---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
---

<Base
  title="Ocorrências em curso"
  description="Ocorrências de proteção civil em curso em todo o país, com dados da ANEPC via Fogos.pt."
>
  <CabecalhoPagina
    titulo="Ocorrências em curso"
    resumo="Incêndios, acidentes e outras ocorrências ativas em todo o país, atualizadas a cada 2 minutos."
  />

  <div class="contentor seccao">
    <div class="destaque">
      <p><strong>Em caso de emergência ligue 112.</strong> Esta lista é informativa e pode ter atraso.</p>
    </div>

    <p class="aguardar">A carregar as ocorrências…</p>
    <p class="indisponivel" hidden>
      Neste momento não é possível mostrar as ocorrências. Consulte <a href="https://fogos.pt" rel="noopener">fogos.pt</a>
      ou <a href="https://prociv.gov.pt" rel="noopener">prociv.gov.pt</a>.
    </p>

    <div class="painel" hidden>
      <dl class="numeros">
        <div><dt>Ocorrências ativas</dt><dd data-n="total">0</dd></div>
        <div><dt>Incêndios</dt><dd data-n="incendios">0</dd></div>
        <div><dt>Operacionais no terreno</dt><dd data-n="operacionais">0</dd></div>
      </dl>

      <div class="filtros">
        <label>
          Estado
          <select class="estado">
            <option value="">Todas as ativas</option>
          </select>
        </label>
        <label>
          Distrito
          <select class="distrito">
            <option value="">Todos os distritos</option>
          </select>
        </label>
        <label>
          Concelho
          <select class="concelho" disabled>
            <option value="">Todos os concelhos</option>
          </select>
        </label>
        <label class="so-incendios"><input type="checkbox" class="incendios" /> Só incêndios</label>
        <button type="button" class="botao-tabua">Ver Tábua</button>
        <button type="button" class="limpar">Limpar filtros</button>
      </div>
      <p class="hora"></p>

      <div class="cabeca-lista">
        <h2 class="titulo-lista">Todo o país</h2>
        <div class="vistas" role="group" aria-label="Forma de ver">
          <button type="button" data-vista="lista" aria-pressed="false">Lista</button>
          <button type="button" data-vista="mapa" aria-pressed="true">Mapa</button>
        </div>
      </div>
      <div class="mapa-envolvente">
        <div class="mapa" role="region" aria-label="Mapa das ocorrências"></div>
        <p class="legenda">
          Toque num ponto para ver os detalhes. O tamanho do ponto indica o número de operacionais; a cor indica o estado.
          <span class="sem-local" hidden></span>
        </p>
      </div>
      <div class="tabela-envolvente" hidden>
        <table class="tabela">
          <thead>
            <tr>
              <th scope="col">Ocorrência</th>
              <th scope="col">Estado</th>
              <th scope="col">Local</th>
              <th scope="col">Início</th>
              <th scope="col" class="num">Operacionais</th>
              <th scope="col" class="num">Terrestres</th>
              <th scope="col" class="num">Aéreos</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <p class="vazio" hidden>Não há ocorrências com estes filtros.</p>
    </div>

    <p class="fonte">
      Fonte: <a href="https://fogos.pt" rel="noopener">Fogos.pt</a>, com dados da ANEPC. Informação indicativa e com
      localização aproximada.
    </p>
  </div>
</Base>

<style>
  .numeros {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .numeros div {
    background: var(--fundo-alt);
    border-radius: var(--raio);
    padding: 0.9rem 1rem;
  }

  .numeros dt {
    font-size: 0.9rem;
    color: var(--tinta-suave);
  }

  .numeros dd {
    margin: 0.2rem 0 0;
    font-size: 2rem;
    font-weight: 800;
    color: var(--vermelho);
    line-height: 1.1;
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1rem;
  }

  .filtros label {
    display: grid;
    gap: 0.25rem;
    font-weight: 600;
  }

  .filtros .so-incendios {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.4rem;
  }

  .filtros select {
    font: inherit;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--linha);
    border-radius: 6px;
    min-width: 12rem;
  }

  .filtros button {
    font: inherit;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    border: 1px solid var(--linha);
    background: #fff;
    cursor: pointer;
  }

  .filtros .botao-tabua {
    border-color: var(--vermelho);
    color: var(--vermelho);
  }

  .filtros select:disabled {
    opacity: 0.6;
  }

  .hora {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: var(--tinta-suave);
  }

  .cabeca-lista {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
  }

  .cabeca-lista h2 {
    margin: 0;
  }

  .vistas {
    display: inline-flex;
    border: 1px solid var(--vermelho);
    border-radius: 999px;
    overflow: hidden;
  }

  .vistas button {
    font: inherit;
    font-weight: 700;
    border: 0;
    background: #fff;
    color: var(--vermelho);
    padding: 0.4rem 1.1rem;
    cursor: pointer;
  }

  .vistas button[aria-pressed='true'] {
    background: var(--vermelho);
    color: #fff;
  }

  .mapa {
    height: min(70vh, 40rem);
    min-height: 22rem;
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    z-index: 0;
  }

  .legenda {
    font-size: 0.85rem;
    color: var(--tinta-suave);
  }

  .mapa :global(.leaflet-popup-content) {
    margin: 0.75rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .mapa :global(.popup strong) {
    display: block;
    font-size: 1rem;
  }

  .mapa :global(.popup p) {
    margin: 0.2rem 0 0;
  }

  .titulo-lista {
    font-size: 1.3rem;
  }

  .tabela {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .tabela th {
    text-align: left;
    font-size: 0.85rem;
    color: var(--tinta-suave);
    border-bottom: 2px solid var(--linha);
    padding: 0.5rem 0.6rem;
    white-space: nowrap;
  }

  .tabela :global(td) {
    padding: 0.55rem 0.6rem;
    border-bottom: 1px solid var(--linha);
    vertical-align: top;
  }

  .tabela :global(tr.tabua) {
    background: #fff8e6;
  }

  .tabela :global(td:first-child) {
    border-left: 5px solid var(--cor, var(--vermelho));
    font-weight: 600;
  }

  .tabela :global(.num),
  .tabela .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .tabela :global(.selo) {
    display: inline-block;
    margin-left: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--vermelho);
  }

  .tabela :global(.sub) {
    display: block;
    font-size: 0.85rem;
    color: var(--tinta-suave);
  }

  /* No telemóvel cada ocorrência passa a ser uma linha compacta. */
  @media (max-width: 47.99rem) {
    .tabela thead {
      display: none;
    }

    .tabela,
    .tabela :global(tbody),
    .tabela :global(tr) {
      display: block;
    }

    .tabela :global(tr) {
      border-left: 5px solid var(--cor, var(--vermelho));
      border-bottom: 1px solid var(--linha);
      padding: 0.6rem 0.75rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.1rem 0.75rem;
    }

    .tabela :global(td) {
      border: 0 !important;
      padding: 0;
    }

    .tabela :global(td.local) {
      grid-column: 1 / -1;
      font-size: 0.9rem;
    }

    .tabela :global(td.inicio) {
      grid-row: 1;
      grid-column: 2;
      text-align: right;
      color: var(--tinta-suave);
      font-size: 0.85rem;
    }

    .tabela :global(td.estado-c) {
      font-size: 0.85rem;
    }

    .tabela :global(td.num) {
      display: none;
    }

    .tabela :global(td.meios-m) {
      display: block;
      grid-column: 1 / -1;
      font-size: 0.85rem;
      color: var(--tinta-suave);
    }
  }

  @media (min-width: 48rem) {
    .tabela :global(td.meios-m) {
      display: none;
    }
  }

  .fonte,
  .aguardar {
    font-size: 0.9rem;
    color: var(--tinta-suave);
    margin-top: 1.5rem;
  }
</style>

<script>
  import 'leaflet/dist/leaflet.css';
  import { lerOcorrencias, horaAgora, resumo, plural, type Ocorrencia } from '../lib/ocorrencias-cliente';

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const painel = $('.painel');
  const selEstado = $<HTMLSelectElement>('.estado');
  const selDistrito = $<HTMLSelectElement>('.distrito');
  const selConcelho = $<HTMLSelectElement>('.concelho');
  const chkIncendios = $<HTMLInputElement>('.incendios');
  let todas: Ocorrencia[] = [];
  let visiveis: Ocorrencia[] = [];
  let vista: 'lista' | 'mapa' = location.hash === '#lista' ? 'lista' : 'mapa';

  // ---- Mapa (Leaflet + OpenStreetMap), carregado só quando é pedido ----
  type L = typeof import('leaflet');
  let leaflet: L | null = null;
  let mapa: import('leaflet').Map | null = null;
  let camada: import('leaflet').LayerGroup | null = null;
  let ultimoEnquadramento = '';
  const PORTUGAL: [[number, number], [number, number]] = [[36.9, -9.6], [42.2, -6.1]];

  function popup(o: Ocorrencia) {
    const div = document.createElement('div');
    div.className = 'popup';
    const add = (tag: string, txt: string) => {
      if (!txt) return;
      const el = document.createElement(tag);
      el.textContent = txt;
      div.append(el);
    };
    add('strong', o.natureza || 'Ocorrência');
    add('p', o.estado + (o.hora ? ` · desde as ${o.hora}` : ''));
    add('p', [o.localidade, o.freguesia, o.concelho, o.distrito].filter((v, i, a) => v && a.indexOf(v) === i).join(', '));
    add(
      'p',
      [
        o.operacionais ? plural(o.operacionais, 'operacional', 'operacionais') : '',
        o.terrestres ? plural(o.terrestres, 'meio terrestre', 'meios terrestres') : '',
        o.aereos ? plural(o.aereos, 'meio aéreo', 'meios aéreos') : '',
      ]
        .filter(Boolean)
        .join(' · '),
    );
    return div;
  }

  async function desenharMapa() {
    if (!leaflet) {
      leaflet = (await import('leaflet')).default as unknown as L;
      mapa = leaflet.map($('.mapa'), { scrollWheelZoom: false }).fitBounds(PORTUGAL);
      leaflet
        .tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> · Fogos.pt / ANEPC',
        })
        .addTo(mapa);
      camada = leaflet.layerGroup().addTo(mapa);
    }
    const Lf = leaflet!;
    mapa!.invalidateSize();
    camada!.clearLayers();

    const comLocal = visiveis.filter((o) => o.lat && o.lng);
    const semLocal = visiveis.length - comLocal.length;
    const aviso = $('.sem-local');
    aviso.hidden = semLocal === 0;
    aviso.textContent = semLocal ? ` ${plural(semLocal, 'ocorrência não tem', 'ocorrências não têm')} localização e só aparece na lista.` : '';

    // Desenhar as maiores primeiro, para as pequenas ficarem por cima e serem clicáveis.
    const ordem = [...comLocal].sort((a, b) => b.operacionais - a.operacionais);
    for (const o of ordem) {
      const cor = o.cor ? `#${o.cor}` : '#b5121b';
      Lf.circleMarker([o.lat!, o.lng!], {
        radius: Math.min(22, 6 + Math.sqrt(o.operacionais || 0) * 1.6),
        color: o.tabua ? '#111' : '#fff',
        weight: o.tabua ? 3 : 1.5,
        fillColor: cor,
        fillOpacity: 0.85,
      })
        .bindPopup(popup(o))
        .bindTooltip(`${o.natureza} · ${o.concelho}`, { direction: 'top' })
        .addTo(camada!);
    }

    // Reenquadrar só quando os filtros mudam, não a cada atualização automática.
    const chave = [selEstado.value, selDistrito.value, selConcelho.value, chkIncendios.checked].join('|');
    if (chave !== ultimoEnquadramento) {
      ultimoEnquadramento = chave;
      if (comLocal.length && (selDistrito.value || selConcelho.value)) {
        mapa!.fitBounds(Lf.latLngBounds(comLocal.map((o) => [o.lat!, o.lng!] as [number, number])).pad(0.3), {
          maxZoom: 11,
        });
      } else {
        mapa!.fitBounds(PORTUGAL);
      }
    }
  }

  function mudarVista(nova: 'lista' | 'mapa') {
    vista = nova;
    document.querySelectorAll<HTMLButtonElement>('.vistas button').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.vista === nova));
    });
    $('.mapa-envolvente').hidden = nova !== 'mapa';
    history.replaceState(null, '', nova === 'lista' ? '#lista' : location.pathname);
    if (todas.length) desenhar();
  }

  document.querySelectorAll<HTMLButtonElement>('.vistas button').forEach((b) =>
    b.addEventListener('click', () => mudarVista(b.dataset.vista as 'lista' | 'mapa')),
  );

  const unicos = (v: string[]) => [...new Set(v.filter(Boolean))].sort((a, b) => a.localeCompare(b, 'pt'));
  const contar = (lista: Ocorrencia[], f: (o: Ocorrencia) => boolean) => lista.filter(f).length;

  // Tábua primeiro, depois as mais graves (mais meios).
  const ordenar = (a: Ocorrencia, b: Ocorrencia) =>
    Number(b.tabua) - Number(a.tabua) ||
    Number(b.importante) - Number(a.importante) ||
    b.operacionais - a.operacionais ||
    b.inicio - a.inicio;

  function preencher(sel: HTMLSelectElement, vazio: string, valores: string[], n: (v: string) => number) {
    const atual = sel.value;
    sel.replaceChildren(new Option(vazio, ''), ...valores.map((v) => new Option(`${v} (${n(v)})`, v)));
    sel.value = valores.includes(atual) ? atual : '';
  }

  function celula(texto: string, classe = '') {
    const td = document.createElement('td');
    td.textContent = texto;
    if (classe) td.className = classe;
    return td;
  }

  function linha(o: Ocorrencia) {
    const tr = document.createElement('tr');
    if (o.cor) tr.style.setProperty('--cor', `#${o.cor}`);
    if (o.tabua) tr.className = 'tabua';
    const nome = celula(o.natureza || 'Ocorrência');
    if (o.tabua) {
      const selo = document.createElement('span');
      selo.className = 'selo';
      selo.textContent = 'TÁBUA';
      nome.append(selo);
    }
    const local = celula([o.concelho, o.distrito].filter(Boolean).join(', '), 'local');
    const sitio = [o.localidade, o.freguesia].filter((v, i, a) => v && a.indexOf(v) === i).join(', ');
    if (sitio) {
      const s = document.createElement('span');
      s.className = 'sub';
      s.textContent = sitio;
      local.append(s);
    }
    const meios = [
      o.operacionais ? plural(o.operacionais, 'operacional', 'operacionais') : '',
      o.terrestres ? plural(o.terrestres, 'meio terrestre', 'meios terrestres') : '',
      o.aereos ? plural(o.aereos, 'meio aéreo', 'meios aéreos') : '',
    ].filter(Boolean);
    tr.append(
      nome,
      celula(o.estado, 'estado-c'),
      local,
      celula(o.hora, 'inicio'),
      celula(String(o.operacionais || 0), 'num'),
      celula(String(o.terrestres || 0), 'num'),
      celula(String(o.aereos || 0), 'num'),
      celula(meios.join(' · '), 'meios-m'),
    );
    return tr;
  }

  function desenhar() {
    const estado = selEstado.value;
    const distrito = selDistrito.value;
    const base = todas.filter((o) => (!estado || o.estado === estado) && (!chkIncendios.checked || o.incendio));

    // Concelhos dependem do distrito escolhido.
    const doDistrito = base.filter((o) => !distrito || o.distrito === distrito);
    preencher(selConcelho, 'Todos os concelhos', unicos(doDistrito.map((o) => o.concelho)), (c) =>
      contar(doDistrito, (o) => o.concelho === c),
    );
    selConcelho.disabled = !distrito;
    if (!distrito) selConcelho.value = '';
    const concelho = selConcelho.value;

    const filtradas = doDistrito.filter((o) => !concelho || o.concelho === concelho).sort(ordenar);

    const r = resumo(filtradas);
    for (const chave of ['total', 'incendios', 'operacionais'] as const) {
      $(`[data-n="${chave}"]`).textContent = r[chave].toLocaleString('pt-PT');
    }

    $('.titulo-lista').textContent = concelho
      ? `Concelho de ${concelho}`
      : distrito
        ? `Distrito de ${distrito}`
        : 'Todo o país';
    $('.tabela tbody').replaceChildren(...filtradas.map(linha));
    $('.tabela-envolvente').hidden = filtradas.length === 0 || vista !== 'lista';
    visiveis = filtradas;
    if (vista === 'mapa') desenharMapa();
    $('.vazio').hidden = filtradas.length > 0;
  }

  async function atualizar() {
    const lista = await lerOcorrencias();
    $('.aguardar').hidden = true;
    if (!lista) {
      if (!todas.length) $('.indisponivel').hidden = false;
      return;
    }
    todas = lista;
    $('.indisponivel').hidden = true;

    preencher(selEstado, 'Todas as ativas', unicos(todas.map((o) => o.estado)), (e) =>
      contar(todas, (o) => o.estado === e),
    );
    preencher(selDistrito, 'Todos os distritos', unicos(todas.map((o) => o.distrito)), (d) =>
      contar(todas, (o) => o.distrito === d),
    );

    $('.hora').textContent = horaAgora();
    painel.hidden = false;
    desenhar();
  }

  selEstado.addEventListener('change', desenhar);
  selDistrito.addEventListener('change', () => {
    selConcelho.value = '';
    desenhar();
  });
  selConcelho.addEventListener('change', desenhar);
  chkIncendios.addEventListener('change', desenhar);

  $('.botao-tabua').addEventListener('click', () => {
    // Tábua pertence ao distrito de Coimbra; se não houver ocorrências lá, a lista fica vazia.
    selEstado.value = '';
    chkIncendios.checked = false;
    if (![...selDistrito.options].some((op) => op.value === 'Coimbra')) selDistrito.append(new Option('Coimbra (0)', 'Coimbra'));
    selDistrito.value = 'Coimbra';
    desenhar();
    if (![...selConcelho.options].some((op) => op.value === 'Tábua')) selConcelho.append(new Option('Tábua (0)', 'Tábua'));
    selConcelho.value = 'Tábua';
    desenhar();
  });

  $('.limpar').addEventListener('click', () => {
    selEstado.value = '';
    selDistrito.value = '';
    selConcelho.value = '';
    chkIncendios.checked = false;
    desenhar();
  });

  mudarVista(vista);
  atualizar();
  setInterval(atualizar, 120_000);
</script>

---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Texto from '../components/Texto.astro';
import { pagina } from '../lib/paginas';

const p = await pagina('corpo-de-bombeiros');
---

<Base title={p.titulo} description={p.descricao || undefined}>
  <CabecalhoPagina titulo={p.titulo} resumo={p.resumo} />

  <div class="contentor seccao">
    <div class="prosa">
      <Texto md={p.corpo} />
    </div>

    <h2 id="frota">{p.frota_titulo || 'Frota'}</h2>
    <Texto md={p.frota_texto} />
    <div class="grelha">
      {
        (p.frota ?? []).map((v: any) => (
          <div class="cartao">
            {v.foto && <img class="foto" src={v.foto} alt={v.nome} loading="lazy" />}
            {v.sigla && <p class="sigla">{v.sigla}</p>}
            <h3>{v.nome}</h3>
            {v.funcao && <p>{v.funcao}</p>}
          </div>
        ))
      }
    </div>

    <div class="prosa" id="quartel">
      <Texto md={p.quartel} />
    </div>
  </div>
</Base>

<style>
  .sigla {
    display: inline-block;
    margin: 0 0 0.5rem;
    background: var(--vermelho);
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.15em 0.6em;
    border-radius: 6px;
  }

  .foto {
    border-radius: 6px;
    margin-bottom: 0.75rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }

  .cartao h3 {
    margin-top: 0;
  }
</style>
